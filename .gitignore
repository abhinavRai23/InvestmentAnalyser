# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# personal portfolio data & reports (privacy protection)
data/reports/*
!data/reports/.gitkeep
data/*.xlsx
data/custom_assets*.json
!data/custom_assets.example.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
